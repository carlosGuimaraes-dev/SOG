# =============================================================================
# EXEMPLO DE VARIÁVEIS DE AMBIENTE — PROJETO SOG
# =============================================================================
# O projeto utiliza dois arquivos de ambiente separados:
#   • .env.api   → variáveis do serviço API (FastAPI / dashboard)
#   • .env.agente → variáveis do serviço Agente (automação PJE/SISTJ/Datajud)
#
# Copie este arquivo para os respectivos destinos e preencha os valores reais.
# NUNCA comite credenciais reais no repositório.
# =============================================================================

# =============================================================================
# .env.api  —  Serviço API (docker-compose service: api)
# =============================================================================

# Dashboard (obrigatórias)
DASHBOARD_USUARIO=admin
DASHBOARD_SENHA_HASH=$2b$12$...  # bcrypt hash — obrigatório para login

# JWT / Segurança da API (obrigatória)
# Deve ter pelo menos 32 caracteres. Altere em produção!
JWT_SECRET_KEY=change-me-in-production-min-32-chars-long-key

# CORS (opcional, default: http://localhost:3000)
FRONTEND_URL=http://localhost:3000

# Caminho do banco SQLite (compartilhado com o agente)
DB_PATH=/dados/custas.db

# =============================================================================
# .env.agente  —  Serviço Agente (docker-compose service: agente)
# =============================================================================

# PJE (SSO/2FA interativo; não armazene usuário/senha aqui)
PJE_URL=https://pje.tjdft.jus.br/pje/login.seam
PJE_ETIQUETA=SHEILA DE DEUS (TREINAMENTO)
# PJE_INDICADORES_SUCESSO=["Nome do Usuário Logado"]  # opcional

# SISTJWEB (SSO/2FA interativo; não armazene usuário/senha aqui)
SISTJ_URL=https://sistj.tjdft.jus.br/sistj/sistj

# Datajud API (obrigatória para consultas Datajud)
DATAJUD_API_KEY=sua_chave_datajud
DATAJUD_URL=https://api-publica.datajud.cnj.jus.br/api_publica_tjdft/_search

# Notificação por e-mail (obrigatórias para envio de alertas)
SMTP_HOST=smtp.gmail.com
SMTP_PORTA=587
SMTP_USUARIO=seu_email@gmail.com
SMTP_SENHA=sua_senha_app
EMAIL_DESTINO=destino@email.com

# Caminho do banco SQLite (compartilhado com a API)
DB_PATH=/dados/custas.db

# Playwright / Execução (opcionais, valores padrão mostrados)
HEADLESS=true
MAX_TENTATIVAS=3
TIMEOUT_PADRAO=30000

# OpenAI / LLM (opcionais, usados para análise de conteúdo)
# OPENAI_API_KEY=sua_chave_openai
# OPENAI_MODEL=gpt-4o-mini
# LLM_MAX_TOKENS=500
# LLM_TEMPERATURE=0.1
